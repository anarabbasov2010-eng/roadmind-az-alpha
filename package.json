{
  "name": "roadmind-az-alpha",
  "version": "0.3.0",
  "private": true,
  "description": "RoadMind AZ — a desktop digital-twin lab for road-infrastructure scenarios in Baku.",
  "author": "242NM",
  "license": "MIT",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "icons": "node scripts/generate-icons.cjs",
    "desktop:dev": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && electron .\"",
    "dist:win": "npm run icons && npm run build && electron-builder --win nsis --x64 --publish never",
    "release:win": "npm run icons && npm run build && electron-builder --win nsis --x64 --publish always"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "maplibre-gl": "^6.14.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^9.2.0",
    "electron": "^37.2.6",
    "electron-builder": "^26.0.12",
    "sharp": "^0.34.3",
    "typescript": "~5.8.3",
    "vite": "^6.3.5",
    "wait-on": "^8.0.3",
    "electron-updater": "^6.6.2",
    "electron-log": "^5.4.3"
  },
  "build": {
    "appId": "az.roadmind.desktop",
    "productName": "RoadMind AZ",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "icon": "electron/roadmind.ico",
      "target": [
        "nsis"
      ],
      "artifactName": "RoadMind-AZ-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "perMachine": false,
      "allowElevation": true,
      "deleteAppDataOnUninstall": false
    },
    "publish": [
      {
        "provider": "github",
        "owner": "anarabbasov2010-eng",
        "repo": "roadmind-az-alpha"
      }
    ]
  }
}
